# Optional overrides for `docker compose up`. Copy to .env (gitignored) and edit.
# Per-service settings for running without Docker live in gateway/.env.example and frontend/.env.example.

# Required outside local dev; the gateway refuses to start in production with the default.
JWT_SECRET=dev-secret-change-me

# true = random boxes instead of the ONNX model (UI work). Takes precedence over inference/models/best.onnx.
MOCK_MODE=false

# Recorded on each inspection; change when you ship a new model.
MODEL_VERSION=yolov8n-neu-det-v1
