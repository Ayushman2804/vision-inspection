PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inspection
DB_SSL=false
JWT_SECRET=change-me
INFERENCE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
# Keep the image of Live video frames: none | defects (default: failed frames only) | all. Uploads are always kept.
SAVE_VIDEO_FRAMES=defects
# Alert when >= ALERT_THRESHOLD of the last ALERT_WINDOW inspections failed
ALERT_WINDOW=20
ALERT_THRESHOLD=0.5
ALERT_COOLDOWN_SEC=60
# Demo account used by `npm run seed` (real-model demo history, backdated over a week; never seed production)
SEED_EMAIL=demo@example.test
SEED_PASSWORD=demo-password-123
# Tests only: fail instead of skipping the Postgres-backed tests when no DB is reachable (CI sets 1)
# REQUIRE_DB=1
